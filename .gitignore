# ---- KHÔNG đẩy dữ liệu chạy cục bộ / môi trường lên GitHub ----

# Môi trường Python cục bộ (2.9 GB!)
.venv/
venv/
.tools/
.agents/

# Cache Python
__pycache__/
*.pyc

# Dữ liệu runtime (quá lớn, sinh khi chạy app)
output/
data/web_upload/
data/scan_pages/
data/scan_pages_gdrive/
data/gdrive_in/

# File hệ điều hành / editor
.DS_Store
*.swp
*.swo

# Git lock/tmp
*.orig

# Models lớn (>100MB vượt giới hạn GitHub)
*.onnx
